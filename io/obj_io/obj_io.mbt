///|
/// OBJ face vertex: vertex / texcoord / normal indices (1-based, 0 = absent).
/// OBJ 面顶点：顶点 / 纹理 / 法线索引（1 起，0 表示无）。
pub struct ObjFaceVertex {
  v : Int32
  vt : Int32
  vn : Int32
}

///|
/// Construct an OBJ face vertex. / 构造 OBJ 面顶点。
pub fn ObjFaceVertex::new(v : Int32, vt : Int32, vn : Int32) -> ObjFaceVertex {
  { v, vt, vn, }
}

///|
/// OBJ face: list of face vertices. / OBJ 面：面顶点列表。
pub struct ObjFace {
  verts : Array[ObjFaceVertex]
}

///|
/// Construct an OBJ face. / 构造 OBJ 面。
pub fn ObjFace::new(verts : Array[ObjFaceVertex]) -> ObjFace {
  { verts, }
}

///|
/// OBJ mesh: vertices, texcoords, normals, faces.
/// OBJ 网格：顶点、纹理坐标、法线、面。
pub struct ObjMesh {
  vertices : Array[@core.Point3D]
  texcoords : Array[(Double, Double)]
  normals : Array[@core.Point3D]
  faces : Array[ObjFace]
}

///|
pub extend ObjMesh with @core.VertexCountable::{vertex_count}

///|
pub extend ObjMesh with @core.FaceCountable::{face_count}

///|
/// Create an empty OBJ mesh. / 创建空 OBJ 网格。
pub fn ObjMesh::new() -> ObjMesh {
  { vertices: [], texcoords: [], normals: [], faces: [], }
}

///|
/// Number of vertices. / 顶点数。
pub impl @core.VertexCountable for ObjMesh with fn vertex_count(self) {
  self.vertices.length()
}

///|
/// Number of faces. / 面数。
pub impl @core.FaceCountable for ObjMesh with fn face_count(self) {
  self.faces.length()
}

///|
/// Write OBJ mesh to text. / 将 OBJ 网格写为文本。
pub fn obj_write(mesh : ObjMesh) -> String {
  let mut out = "# Generated by moon-geometry\n"
  for p in mesh.vertices {
    out += "v " +
      p.x.to_string() +
      " " +
      p.y.to_string() +
      " " +
      p.z.to_string() +
      "\n"
  }
  for t in mesh.texcoords {
    out += "vt " + t.0.to_string() + " " + t.1.to_string() + "\n"
  }
  for n in mesh.normals {
    out += "vn " +
      n.x.to_string() +
      " " +
      n.y.to_string() +
      " " +
      n.z.to_string() +
      "\n"
  }
  for f in mesh.faces {
    out += "f"
    for fv in f.verts {
      out += " " + face_vert_str(fv)
    }
    out += "\n"
  }
  out
}

///|
fn face_vert_str(fv : ObjFaceVertex) -> String {
  let v = fv.v.to_string()
  if fv.vt > 0 && fv.vn > 0 {
    v + "/" + fv.vt.to_string() + "/" + fv.vn.to_string()
  } else if fv.vt > 0 {
    v + "/" + fv.vt.to_string()
  } else if fv.vn > 0 {
    v + "//" + fv.vn.to_string()
  } else {
    v
  }
}

///|
/// Parse OBJ text into mesh. / 将 OBJ 文本解析为网格。
pub fn obj_parse(text : String) -> ObjMesh {
  let mesh = ObjMesh::new()
  for line in text.split("\n") {
    let parts = tokens(line)
    if parts.length() == 0 {
      continue
    }
    let cmd = parts[0].to_owned()
    if cmd == "v" && parts.length() >= 4 {
      mesh.vertices.push(
        @core.Point3D::new(pd(parts[1]), pd(parts[2]), pd(parts[3])),
      )
    } else if cmd == "vt" && parts.length() >= 3 {
      mesh.texcoords.push((pd(parts[1]), pd(parts[2])))
    } else if cmd == "vn" && parts.length() >= 4 {
      mesh.normals.push(
        @core.Point3D::new(pd(parts[1]), pd(parts[2]), pd(parts[3])),
      )
    } else if cmd == "f" && parts.length() >= 2 {
      let fv : Array[ObjFaceVertex] = []
      for k in 1..<parts.length() {
        fv.push(parse_face_vert(parts[k]))
      }
      if fv.length() > 0 {
        mesh.faces.push(ObjFace::new(fv))
      }
    }
  }
  mesh
}

///|
fn parse_face_vert(s : StringView) -> ObjFaceVertex {
  let mut v = 0
  let mut vt = 0
  let mut vn = 0
  let mut idx = 0
  for tok in s.split("/") {
    let t = tok.trim()
    if t.length() > 0 {
      let n = pi(t)
      if idx == 0 {
        v = n
      } else if idx == 1 {
        vt = n
      } else {
        vn = n
      }
    }
    idx += 1
  }
  { v, vt, vn, }
}

///|
/// Parse a Double from a string view. / 从字符串视图解析 Double。
pub fn parse_double_sv(s : StringView) -> Double {
  pd(s)
}

///|
fn pd(s : StringView) -> Double {
  let t = s.trim()
  if t.length() == 0 {
    return 0.0
  }
  let chars = t.to_array()
  let n = chars.length()
  let mut i = 0
  let mut neg = false
  if chars[0] == '-' {
    neg = true
    i = 1
  } else if chars[0] == '+' {
    i = 1
  }
  let mut int_part = 0.0
  while i < n && chars[i] != '.' && chars[i] != 'e' && chars[i] != 'E' {
    if chars[i] >= '0' && chars[i] <= '9' {
      int_part = int_part * 10.0 + (chars[i].to_int() - 48).to_double()
      i += 1
    } else {
      break
    }
  }
  let mut frac = 0.0
  let mut div = 1.0
  if i < n && chars[i] == '.' {
    i += 1
    while i < n && chars[i] != 'e' && chars[i] != 'E' {
      if chars[i] >= '0' && chars[i] <= '9' {
        frac = frac * 10.0 + (chars[i].to_int() - 48).to_double()
        div *= 10.0
        i += 1
      } else {
        break
      }
    }
  }
  let mut res = int_part + frac / div
  if i < n && (chars[i] == 'e' || chars[i] == 'E') {
    i += 1
    let mut en = false
    if i < n && chars[i] == '-' {
      en = true
      i += 1
    } else if i < n && chars[i] == '+' {
      i += 1
    }
    let mut e = 0
    while i < n && chars[i] >= '0' && chars[i] <= '9' {
      e = e * 10 + (chars[i].to_int() - 48)
      i += 1
    }
    let m = @math.pow(10.0, e.to_double())
    if en {
      res = res / m
    } else {
      res = res * m
    }
  }
  if neg {
    -res
  } else {
    res
  }
}

///|
fn pi(s : StringView) -> Int32 {
  let t = s.trim()
  if t.length() == 0 {
    return 0
  }
  let chars = t.to_array()
  let n = chars.length()
  let mut i = 0
  let mut neg = false
  if chars[0] == '-' {
    neg = true
    i = 1
  } else if chars[0] == '+' {
    i = 1
  }
  let mut v = 0
  while i < n && chars[i] >= '0' && chars[i] <= '9' {
    v = v * 10 + (chars[i].to_int() - 48)
    i += 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///|
fn tokens(s : StringView) -> Array[StringView] {
  let result : Array[StringView] = []
  let mut cur = ""
  for c in s.iter() {
    if c == ' ' || c == '\t' || c == '\r' {
      if cur.length() > 0 {
        result.push(cur.to_string_view())
        cur = ""
      }
    } else {
      cur += c.to_string()
    }
  }
  if cur.length() > 0 {
    result.push(cur.to_string_view())
  }
  result
}
