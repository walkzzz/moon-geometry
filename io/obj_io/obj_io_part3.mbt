///|
/// Write OBJ mesh to text. / 将 OBJ 网格写为文本。
pub fn obj_write(mesh : ObjMesh) -> String {
  let mut out = "# Generated by moon-geometry\n"
  for p in mesh.vertices {
    out += "v " +
      p.x.to_string() +
      " " +
      p.y.to_string() +
      " " +
      p.z.to_string() +
      "\n"
  }
  for t in mesh.texcoords {
    out += "vt " + t.0.to_string() + " " + t.1.to_string() + "\n"
  }
  for n in mesh.normals {
    out += "vn " +
      n.x.to_string() +
      " " +
      n.y.to_string() +
      " " +
      n.z.to_string() +
      "\n"
  }
  for f in mesh.faces {
    out += "f"
    for fv in f.verts {
      out += " " + face_vert_str(fv)
    }
    out += "\n"
  }
  out
}

///|
fn face_vert_str(fv : ObjFaceVertex) -> String {
  let v = fv.v.to_string()
  if fv.vt > 0 && fv.vn > 0 {
    v + "/" + fv.vt.to_string() + "/" + fv.vn.to_string()
  } else if fv.vt > 0 {
    v + "/" + fv.vt.to_string()
  } else if fv.vn > 0 {
    v + "//" + fv.vn.to_string()
  } else {
    v
  }
}
