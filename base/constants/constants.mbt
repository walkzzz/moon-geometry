///|
/// Pi. / 圆周率。
pub let pi : Double = 3.141592653589793

///|
/// 2 * Pi. / 2倍圆周率。
pub let two_pi : Double = 6.283185307179586

///|
/// Pi / 2. / 半圆周率。
pub let half_pi : Double = 1.5707963267948966

///|
/// Pi / 4. / 四分之一圆周率。
pub let quarter_pi : Double = 0.7853981633974483

///|
/// Euler's number. / 自然常数。
pub let e : Double = 2.718281828459045

///|
/// Square root of 2. / 根号2。
pub let sqrt2 : Double = 1.4142135623730951

///|
/// Square root of 3. / 根号3。
pub let sqrt3 : Double = 1.7320508075688772

///|
/// Golden ratio. / 黄金比例。
pub let golden_ratio : Double = 1.618033988749895

///|
/// Degrees to radians factor. / 角度转弧度因子。
pub let deg2rad : Double = 0.017453292519943295

///|
/// Radians to degrees factor. / 弧度转角度因子。
pub let rad2deg : Double = 57.29577951308232

///|
/// Epsilon for geometric comparisons. / 几何比较精度。
pub let eps : Double = 0.000000000001
